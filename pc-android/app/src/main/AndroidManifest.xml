<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <application android:allowBackup="false" android:supportsRtl="true" android:usesCleartextTraffic="true"
                 android:label="Mundo X" android:theme="@style/Theme.COSMICX">

        <!-- A single, real personal workspace launch point. -->
        <activity android:name=".MundoXDesktopActivity" android:exported="true"
                  android:label="Mundo X" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Existing own PC and quantum apps remain available inside the desktop.
             Preserve explicit adb/test access to the legacy PC activity. -->
        <activity android:name=".MainActivity" android:exported="true"
                  android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
                  android:windowSoftInputMode="adjustResize" />
        <activity android:name=".QuantumDesktopActivity" android:exported="true"
                  android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
