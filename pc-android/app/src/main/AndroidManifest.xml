<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <application android:allowBackup="false" android:supportsRtl="true" android:usesCleartextTraffic="false"
                 android:label="Mundo X" android:theme="@style/Theme.COSMICX">

        <!-- A single, real personal workspace launch point. -->
        <activity android:name=".MundoXDesktopActivity" android:exported="true"
                  android:label="Mundo X" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Existing own PC and quantum apps remain available inside the desktop.
             Only the launcher is exported; internal workspaces are not externally startable. -->
        <activity android:name=".MainActivity" android:exported="false"
                  android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
                  android:windowSoftInputMode="adjustResize" />
        <activity android:name=".QuantumDesktopActivity" android:exported="false"
                  android:windowSoftInputMode="adjustResize" />
        <!-- Offline educational isotope and nuclear-reaction calculator. -->
        <activity android:name=".FusionLabActivity" android:exported="false"
                  android:label="Mundo X Fusion Lab" android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
