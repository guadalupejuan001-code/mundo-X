<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <application android:label="${solarAppLabel}" android:icon="@drawable/ic_solar"
        android:theme="@style/SolarTheme" android:allowBackup="false"
        android:supportsRtl="true">
        <activity android:name="com.mundox.solar.SolarActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
